# Local API. A deployed PWA must call an HTTPS API behind your host's TLS proxy.
HOST=127.0.0.1
PORT=3001
# Comma-separated exact frontend origins, with no trailing slash or wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Sessions are temporary bearer capabilities; restarting clears them.
SESSION_TTL_MS=1800000
MAX_SESSIONS=200
# Maximum worker inference time; restart the backend if this is exceeded.
INFERENCE_TIMEOUT_MS=15000
LOG_LEVEL=info
# Optional wall/pole/stairs segmentation (SegFormer-b0). 'off' disables it; size is the model input side.
SURFACE_MODEL=on
SURFACE_INPUT_SIZE=320
