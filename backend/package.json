{
  "name": "clarity-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API for checking camera frames and deciding when to send an alert.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "smoke:model": "node scripts/smoke-model.js",
    "measure:latency": "node scripts/measure-latency.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "fastify": "5.12.7",
    "onnxruntime-web": "1.30.0",
    "sharp": "0.34.5"
  }
}
